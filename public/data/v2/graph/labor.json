","sec":"内容要求","pg":[34],"gb":null,"tags":[],"n":[0,0,0]},"LA-S4-PL-04.3":{"t":"根据设计要求选择某项新技术，制订合理的设计、加工方案或设计图样，完成应用某项新技术进行加工、组装、测试、优化的全过程。","std":"LA-S4-PL-04","col":"7-9","sec":"内容要求","pg":[34],"gb":null,"tags":[],"n":[0,0,0]},"LA-S4-PL-04.4":{"t":"记录某项新技术在改变传统加工方式、降低加工成本、提高工件质量方面带来的主要变化。","std":"LA-S4-PL-04","col":"7-9","sec":"内容要求","pg":[34],"gb":null,"tags":[],"n":[0,0,0]},"LA-S4-PL-04.5":{"t":"感受新技术在推动生产力进步、创造美好生活中发挥的重要作用。","std":"LA-S4-PL-04","col":"7-9","sec":"内容要求","pg":[34],"gb":null,"tags":[],"n":[0,0,0]},"LA-S4-PL-04.6":{"t":"能根据需要，使用某项新技术设计制作简单的产品模型或原型，并独立完成产品的技术测试。","std":"LA-S4-PL-04","col":"7-9","sec":"素养表现","pg":[34],"gb":null,"tags":[],"n":[0,0,0]},"LA-S4-PL-04.7":{"t":"在劳动中能不断追求品质、精益求精。","std":"LA-S4-PL-04","col":"7-9","sec":"素养表现","pg":[34],"gb":null,"tags":[],"n":[0,0,0]},"LA-S4-PL-04.8":{"t":"树立劳动光荣、技能宝贵、创造伟大的观念。","std":"LA-S4-PL-04","col":"7-9","sec":"素养表现","pg":[34],"gb":null,"tags":[],"n":[0,0,0]},"LA-S4-SL-01.1":{"t":"根据学生的年龄特征、自身兴趣与实际条件，选择1~2项现代服务业劳动项目进行参与、体验。","std":"LA-S4-SL-01","col":"7-9","sec":"内容要求","pg":[35],"gb":null,"tags":[],"n":[0,0,0]},"LA-S4-SL-01.2":{"t":"根据所参与现代服务业劳动的特征与过程，开展符合相应要求的劳动。","std":"LA-S4-SL-01","col":"7-9","sec":"内容要求","pg":[35],"gb":null,"tags":[],"n":[0,0,0]},"LA-S4-SL-01.3":{"t":"在劳动过程中主动发现有价值的问题，并设计合理的、具有一定创意的问题解决方案。","std":"LA-S4-SL-01","col":"7-9","sec":"内容要求","pg":[35],"gb":null,"tags":[],"n":[0,0,0]},"LA-S4-SL-01.4":{"t":"了解现代服务业劳动所具备的优势与面临的挑战，能说明现代服务业劳动的革新与发展趋势。","std":"LA-S4-SL-01","col":"7-9","sec":"素养表现","pg":[35],"gb":null,"tags":[],"n":[0,0,0]},"LA-S4-SL-01.5":{"t":"能在劳动过程中认真履行职责，养成规范劳动、安全劳动的习惯与品质。","std":"LA-S4-SL-01","col":"7-9","sec":"素养表现","pg":[35],"gb":null,"tags":[],"n":[0,0,0]},"LA-S4-SL-01.6":{"t":"进一步增强公共服务意识，形成以自己的劳动创造美好生活的社会责任感。","std":"LA-S4-SL-01","col":"7-9","sec":"素养表现","pg":[35],"gb":null,"tags":[],"n":[0,0,0]},"LA-S4-SL-02.1":{"t":"利用学生已有的日常生活劳动、生产劳动经验，选择1～2项具有一定挑战性的学校、社区公益劳动与志愿服务项目进行实践。","std":"LA-S4-SL-02","col":"7-9","sec":"内容要求","pg":[35,36],"gb":null,"tags":[],"n":[0,0,0]},"LA