-PL-04.6","LA-S4-PL-04.7","LA-S4-PL-04.8"]},"LA-S4-SL-01":{"title":"现代服务业劳动","stage":"7-9","lane":"l9","points":["LA-S4-SL-01.1","LA-S4-SL-01.2","LA-S4-SL-01.3","LA-S4-SL-01.4","LA-S4-SL-01.5","LA-S4-SL-01.6"]},"LA-S4-SL-02":{"title":"公益劳动与志愿服务","stage":"7-9","lane":"l10","points":["LA-S4-SL-02.1","LA-S4-SL-02.2","LA-S4-SL-02.3","LA-S4-SL-02.4"]}},"points":{"LA-S1-DL-01.1":{"t":"开展简单的清洁劳动，用笤帚扫地，用拖把拖地，用抹布擦桌椅等，用合适的洗涤用品洗碗筷等餐具，用肥皂、洗衣液等洗红领巾。","std":"LA-S1-DL-01","col":"1-2","sec":"内容要求","pg":[16],"gb":null,"tags":[],"n":[0,0,0]},"LA-S1-DL-01.2":{"t":"依据颜色或文字提示辨别不同类型垃圾桶，知道垃圾分类投放的要求。","std":"LA-S1-DL-01","col":"1-2","sec":"内容要求","pg":[16],"gb":null,"tags":[],"n":[0,0,0]},"LA-S1-DL-01.3":{"t":"坚持用科学的方法洗手，独立完成与个人卫生相关的劳动。","std":"LA-S1-DL-01","col":"1-2","sec":"内容要求","pg":[16],"gb":null,"tags":[],"n":[0,0,0]},"LA-S1-DL-01.4":{"t":"养成不随便扔垃圾的习惯，初步建立垃圾分类的意识和维护公共卫生的意识。","std":"LA-S1-DL-01","col":"1-2","sec":"素养表现","pg":[16],"gb":null,"tags":[],"n":[0,0,0]},"LA-S1-DL-01.5":{"t":"在清洁地面、衣物、桌椅等过程中，感受劳动的快乐，愿意参加劳动。","std":"LA-S1-DL-01","col":"1-2","sec":"素养表现","pg":[16],"gb":null,"tags":[],"n":[0,0,0]},"LA-S1-DL-02.1":{"t":"根据需要，整理自己的生活用品、学习用品，如衣物、玩具、书本、文具等。","std":"LA-S1-DL-02","col":"1-2","sec":"内容要求","pg":[16],"gb":null,"tags":[],"n":[0,0,0]},"LA-S1-DL-02.2":{"t":"整理自己的书包、课桌和居室的书柜及书桌，能按照物品类别、形状等整齐摆放，初步建立及时整理与收纳的意识。","std":"LA-S1-DL-02","col":"1-2","sec":"内容要求","pg":[16],"gb":null,"tags":[],"n":[0,0,0]},"LA-S1-DL-03.1":{"t":"参与简单的家庭烹饪劳动，如择菜、洗菜等食材粗加工，根据需要选择合适的工具削水果皮，用合适的器皿冲泡饮品。","std":"LA-S1-DL-03","col":"1-2","sec":"内容要求","pg":[17],"gb":null,"tags":[],"n":[0,0,0]},"LA-S1-DL-03.2":{"t":"初步了解蔬菜、水果、饮品等食物的营养价值和科学的食用方法。","std":"LA-S1-DL-03","col":"1-2","sec":"内容要求","pg":[17],"gb":null,"tags":[],"n":[0,0,0]},"LA-S1-DL-03.3":{"t":"具有安全劳动意识，以及“自己的事情自己做”的生活自理意识。","std":"LA-S1-DL-03","col":"1-2","sec":"素养表现","pg":[17],"gb":null,"tags":[],"n":[0,0,0]},"LA-S1-DL-03.4":{"t":"初步具有科学处理果蔬、制作饮品的意识和能力。","std":"LA-S1-DL-03","col":"1-2","sec":"素养表现","pg":[17],"gb":null,"tags":[],"n":[0,0,0]},"LA-S1-PL-01.1":{"t":"根据实际情况，种植和养护1～2种当地常见的水培或土培植物，如绿萝、文竹等，或饲养1～2种小动物，如金鱼、蚕等。","std":"LA-S1-PL-01","col":"1-2","sec":"内容要求","pg":[17],"gb":null,"tags":[],"n":[0,0,0]},"LA-S1-PL-01.2":{"t":"结合具体植物养护或动物饲养活动，观察植物的生长发育情况，了解小动物的生长发育情况与生活习性，知道身边常见动植物的养护方法，培养对动植物的喜爱之情。","std":"LA-S1-PL-01","col":"1-2","sec":"内容要求","pg":[17],"gb":null,"tags":[],"n":[0,0,0]},"LA-S1-PL-01.3":{"t":"能表达参与农业劳动后收获的快乐，初步具有关心、照顾身边常见动植物的责任心和农业生产安全意识，知道劳动需要长期坚持的道理。","std":"LA-S1-PL-01","col":"1-2","sec":"素养表现","pg":[18],"gb":null,"tags":[],"n":[0,0,0]},"LA-S1-PL-02.1":{"t":"选择1~2项传统工艺制作项目，如纸工、泥工、编织等，了解制作需要的基本材料和常用工具，在教师指导下按照要求和步骤进行简单作品制作，体验传统工艺制作过程。","std":"LA-S1-PL-02","col":"1-2","sec":"内容要求","pg":[18],"gb":null,"tags":[],"n":[0,0,0]},"LA-S1-PL-02.2":{"t":"初步运用文字及图画表达自己的方案构想，对工艺作品进行简单的评价。","std":"LA-S1-PL-02","col":"1-2","sec":"内容要求","pg":[18],"gb":null,"tags":[],"n":[0,0,0]},"LA-S1-PL-02.3":{"t":"感受传统工艺的奇妙，初步养成认真劳动、合理利用材料的良好劳动习惯，形成乐于动手的劳动态度。","std":"LA-S1-PL-02","col":"1-2","sec":"素养表现","pg":[18],"gb":null,"tags":[],"n":[0,0,0]},"LA-S2-DL-01.1":{"t":"理解日常生活清洁与卫生的基本内容，用合适的洗涤用品清洗自己的鞋袜、内衣和书包等。","std":"LA-S2-DL-01","col":"3-4","sec":"内容要求","pg":[19],"gb":null,"tags":[],"n":[0,0,0]},"LA-S2-DL-01.2":{"t":"正确使用卫生工具，参与教室卫生打扫，将桌椅摆放整齐。","std":"LA-S2-DL-01","col":"3-4","sec":"内容要求","pg":[19],"gb":null,"tags":[],"n":[0,0,0]},"LA-S2-DL-01.3":{"t":"分类投放垃圾。","std":"LA-S2-DL-01","col":"3-4","sec":"内容要求","pg":[19],"gb":null,"tags":[],"n":[0,0,0]},"LA-S2-DL-01.4":{"t":"正确使用消毒纸巾、棉球和洗手液，在公共场所能自觉做好个人防护。","std":"LA-S2-DL-01","col":"3-4","sec":"内容要求","pg":[19],"gb":null,"tags":[],"n":[0,0,0]},"LA-S2-DL-01.5":{"t":"通过清洗、打扫、消毒等活动，创设洁净的生活环境和学习环境。","std":"LA-S2-DL-01","col":"3-4","sec":"内容要求","pg":[19],"gb":null,"tags":[],"n":[0,0,0]},"LA-S2-DL-01.6":{"t":"具有用劳动创设洁净的生活、学习环境的意识和公共卫生安全意识，养成良好的个人卫生习惯，具有热爱劳动的态度，初步学会与他人合作劳动。","std":"LA-S2-DL-01","col":"3-4","sec":"素养表现","pg":[19],"gb":null,"tags":[],"n":[0,0,0]},"LA-S2-DL-02.1":{"t":"定期整理居室里的书柜、衣橱、鞋柜和教室里的“图书角”、卫生柜、讲台桌面。","std":"LA-S2-DL-02","col":"3-4","sec":"内容要求","pg":[19],"gb":null,"tags":[],"n":[0,0,0]},"LA-S2-DL-02.2":{"t":"将物品摆放整齐，归类收纳，做到有序、合理、便于取用。","std":"LA-S2-DL-02","col":"3-4","sec":"内容要求","pg":[19],"gb":null,"tags":[],"n":[0,0,0]},"LA-S2-DL-02.3":{"t":"逐步养成及时收纳、分类存放的好习惯。","std":"LA-S2-DL-02","col":"3-4","sec":"素养表现","pg":[19],"gb":null,"tags":[],"n":[0,0,0]},"LA-S2-DL-02.4":{"t":"初步具有做事有条理、整理有方法、收纳有规律的生活能力。","std":"LA-S2-DL-02","col":"3-4","sec":"素养表现","pg":[19],"gb":null,"tags":[],"n":[0,0,0]},"LA-S2-DL-03.1":{"t":"使用简单的烹饪器具对食材进行切配，按照一般流程制作凉拌菜、拼盘，学习用蒸、煮方法加工食材。","std":"LA-S2-DL-03","col":"3-4","sec":"内容要求","pg":[20],"gb":null,"tags":[],"n":[0,0,0]},"LA-S2-DL-03.2":{"t":"加工过程中注意卫生、安全。","std":"LA-S2-DL-03","col":"3-4","sec":"内容要求","pg":[20],"gb":null,"tags":[],"n":[0,0,0]},"LA-S2-DL-03.3":{"t":"形成生活自理能力，初步建立健康饮食的观念。","std":"LA-S2-DL-03","col":"3-4","sec":"素养表现","pg":[20],"gb":null,"tags":[],"n":[0,0,0]},"LA-S2-DL-03.4":{"t":"具有初步的食品安全意识。","std":"LA-S2-DL-03","col":"3-4","sec":"素养表现","pg":[20],"gb":null,"tags":[],"n":[0,0,0]},"LA-S2-DL-03.5":{"t":"能正确认识烹饪劳动的价值，形成热爱劳动、尊重普通劳动者的观念。","std":"LA-S2-DL-03","col":"3-4","sec":"素养表现","pg":[20],"gb":null,"tags":[],"n":[0,0,0]},"LA-S2-DL-04.1":{"t":"正确使用1～2种家庭常用小电器，如吹风机、吸尘器等，完成劳动任务。","std":"LA-S2-DL-04","col":"3-4","sec":"内容要求","pg":[20],"gb":null,"tags":[],"n":[0,0,0]},"LA-S2-DL-04.2":{"t":"认识、了解厨具的种类和作用，正确使用厨房小家电参与家庭烹饪劳动，如用电饭煲煮饭。","std":"LA-S2-DL-04","col":"3-4","sec":"内容要求","pg":[20],"gb":null,"tags":[],"n":[0,0,0]},"LA-S2-DL-04.3":{"t":"知道操作流程要规范、安全。","std":"LA-S2-DL-04","col":"3-4","sec":"内容要求","pg":[20],"gb":null,"tags":[],"n":[0,0,0]},"LA-S2-DL-04.4":{"t":"养成用后及时清理、收纳到位的良好劳动习惯。","std":"LA-S2-DL-04","col":"3-4","sec":"素养表现","pg":[20,21],"gb":null,"tags":[],"n":[0,0,0]},"LA-S2-PL-01.1":{"t":"选择当地1~2种常见的蔬菜，如大白菜、西红柿、黄瓜等进行种植，或者根据区域相关规定，合法合规选择1～2种家禽，如鸡、鸭等进行饲养，体验蔬菜种植、家禽饲养的一般过程与方法。","std":"LA-S2-PL-01","col":"3-4","sec":"内容要求","pg":[21],"gb":null,"tags":[],"n":[0,0,0]},"LA-S2-PL-01.2":{"t":"初步形成关爱生命、尊重自然，遵循动植物生长规律和季节特点进行科学劳动的观念。","std":"LA-S2-PL-01","col":"3-4","sec":"素养表现","pg":[21],"gb":null,"tags":[],"n":[0,0,0]},"LA-S2-PL-01.3":{"t":"初步学会与他人合作劳动，在种植、饲养过程中不怕困难，养成有始有终的劳动习惯，懂得“一分耕耘，一分收获”的道理。","std":"LA-S2-PL-01","col":"3-4","sec":"素养表现","pg":[21],"gb":null,"tags":[],"n":[0,0,0]},"LA-S2-PL-02.1":{"t":"选择1~2项传统工艺制作项目，如纸工、泥工、布艺、编织等，了解制作的技能和方法。","std":"LA-S2-PL-02","col":"3-4","sec":"内容要求","pg":[21,22],"gb":null,"tags":[],"n":[0,0,0]},"LA-S2-PL-02.2":{"t":"识读简单的示意图，尝试设计简单作品，并参考规范流程进行制作。","std":"LA-S2-PL-02","col":"3-4","sec":"内容要求","pg":[22],"gb":null,"tags":[],"n":[0,0,0]},"LA-S2-PL-02.3":{"t":"初步养成专心致志的劳动品质。","std":"LA-S2-PL-02","col":"3-4","sec":"素养表现","pg":[22],"gb":null,"tags":[],"n":[0,0,0]},"LA-S2-SL-01.1":{"t":"根据学生的年龄特征、自身兴趣与实际条件，在批发和零售业，交通运输、仓储和邮政业，住宿和餐饮业，信息传输、软件和信息技术服务业，金融业，房地产业，教育，卫生和社会工作，文化、体育和娱乐业，公共管理、社会保障和社会组织等现代服务行业中，选择1~2项与自身日常生活密切相关的项目进行实践、体验，如开展班徽设计等文化创意服务活动。","std":"LA-S2-SL-01","col":"3-4","sec":"内容要求","pg":[22],"gb":null,"tags":[],"n":[0,0,0]},"LA-S2-SL-01.2":{"t":"体悟现代服务业劳动对于创造便利、美好生活的重要意义，形成尊重现代服务业劳动、劳动者、劳动成果的观念，以及积极参与现代服务业劳动的态度。","std":"LA-S2-SL-01","col":"3-4","sec":"素养表现","pg":[22],"gb":null,"tags":[],"n":[0,0,0]},"LA-S2-SL-01.3":{"t":"体验服务性劳动中的创造性及其带来的挑战与乐趣。","std":"LA-S2-SL-01","col":"3-4","sec":"素养表现","pg":[22],"gb":null,"tags":[],"n":[0,0,0]},"LA-S2-SL-02.1":{"t":"以校园、社区为主，参加1～2项力所能及的公益劳动与志愿服务，利用自身的知识与技能、创造的物质产品与精神产品等，满足他人需要、帮助他人解决问题。","std":"LA-S2-SL-02","col":"3-4","sec":"内容要求","pg":[23],"gb":null,"tags":[],"n":[0,0,0]},"LA-S2-SL-02.2":{"t":"初步了解学校与社区中公益劳动与志愿服务的需求、形式与内容，体验多种服务性劳动过程。","std":"LA-S2-SL-02","col":"3-4","sec":"内容要求","pg":[23],"gb":null,"tags":[],"n":[0,0,0]},"LA-S2-SL-02.3":{"t":"初步形成主动关心他人的意识和公共服务意识，体悟以自己的服务性劳动他人创造便利的自豪感与幸福感。","std":"LA-S2-SL-02","col":"3-4","sec":"素养表现","pg":[23],"gb":null,"tags":[],"n":[0,0,0]},"LA-S2-SL-02.4":{"t":"初步学会与他人合作劳动，形成尊重劳动和普通劳动者的态度，以及感恩他人劳动付出的劳动情感。","std":"LA-S2-SL-02","col":"3-4","sec":"素养表现","pg":[23],"gb":null,"tags":[],"n":[0,0,0]},"LA-S3-DL-01.1":{"t":"通过对物品的整理与取舍，清理自己的学习与生活空间，如清理和合理处置使用过的教科书、簿本，以及不再穿的衣物、不再玩的玩具等。","std":"LA-S3-DL-01","col":"5-6","sec":"内容要求","pg":[24],"gb":null,"tags":[],"n":[0,0,0]},"LA-S3-DL-01.2":{"t":"初步掌握对物品、居室进行整理、清洁的方法，较为充分、合理地利用家居空间，用劳动和智慧为自己和家人创造更舒适的生活环境。","std":"LA-S3-DL-01","col":"5-6","sec":"内容要求","pg":[24],"gb":null,"tags":[],"n":[0,0,0]},"LA-S3-DL-01.3":{"t":"体悟劳动对于创造美好生活的意义，具有初步的劳动筹划思维和家政能力。","std":"LA-S3-DL-01","col":"5-6","sec":"素养表现","pg":[24],"gb":null,"tags":[],"n":[0,0,0]},"LA-S3-DL-02.1":{"t":"用简单的炒、煎、炖等烹饪方法制作2~3道家常菜，如西红柿炒鸡蛋、煎鸡蛋、炖骨头汤等，参与从择菜、洗菜到烧菜、装盘的完整过程。","std":"LA-S3-DL-02","col":"5-6","sec":"内容要求","pg":[24],"gb":null,"tags":[],"n":[0,0,0]},"LA-S3-DL-02.2":{"t":"能根据家人需求设计一顿午餐或晚餐的营养食谱，了解不同烹饪方法与食物营养的关系。","std":"LA-S3-DL-02","col":"5-6","sec":"内容要求","pg":[24],"gb":null,"tags":[],"n":[0,0,0]},"LA-S3-DL-02.3":{"t":"初步养成营养搭配和健康饮食的习惯，具有食品安全意识和绿色消费意识。","std":"LA-S3-DL-02","col":"5-6","sec":"素养表现","pg":[24],"gb":null,"tags":[],"n":[0,0,0]},"LA-S3-DL-02.4":{"t":"树立乐于为家人服务的劳动观念，初步形成家庭责任感。","std":"LA-S3-DL-02","col":"5-6","sec":"素养表现","pg":[24],"gb":null,"tags":[],"n":[0,0,0]},"LA-S3-DL-03.1":{"t":"通过阅读产品说明书，了解家庭常用电器，如电视机、电冰箱、洗衣机、电风扇、空调等的功能特点，掌握基本操作方法。","std":"LA-S3-DL-03","col":"5-6","sec":"内容要求","pg":[25],"gb":null,"tags":[],"n":[0,0,0]},"LA-S3-DL-03.2":{"t":"根据需求选择使用功能，规范、安全地操作。","std":"LA-S3-DL-03","col":"5-6","sec":"内容要求","pg":[25],"gb":null,"tags":[],"n":[0,0,0]},"LA-S3-DL-03.3":{"t":"初步养成良好的家用电器使用习惯。","std":"LA-S3-DL-03","col":"5-6","sec":"素养表现","pg":[25],"gb":null,"tags":[],"n":[0,0,0]},"LA-S3-DL-03.4":{"t":"感受家用电器对提高家务劳动效率、提升生活品质的作用。","std":"LA-S3-DL-03","col":"5-6","sec":"素养表现","pg":[25],"gb":null,"tags":[],"n":[0,0,0]},"LA-S3-DL-03.5":{"t":"养成勤于观察、乐于思考的品质。","std":"LA-S3-DL-03","col":"5-6","sec":"素养表现","pg":[25],"gb":null,"tags":[],"n":[0,0,0]},"LA-S3-PL-01.1":{"t":"种植与养护1～2种当地常见的蔬菜、盆栽花草、果树等，或根据区域相关规定，合法合规饲养1～2种常见家畜，如兔、羊等。","std":"LA-S3-PL-01","col":"5-6","sec":"内容要求","pg":[25],"gb":null,"tags":[],"n":[0,0,0]},"LA-S3-PL-01.2":{"t":"体验简单的种植、饲养等生产劳动，初步学习种植、饲养的基本方法。","std":"LA-S3-PL-01","col":"5-6","sec":"内容要求","pg":[25],"gb":null,"tags":[],"n":[0,0,0]},"LA-S3-PL-01.3":{"t":"感受持续性劳动的艰辛和不易，懂得珍惜劳动成果，养成持之以恒的劳动品质。","