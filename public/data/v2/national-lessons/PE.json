,"title",null,null]],"PE-S4-SS-06.2":[["ed_edad04fc8816a4ef583f","体育与健康9年级全一册","第九章 花样跳绳","a278ae02-fd23-1353-e3d4-079a77c89084","二、双人合作跳绳","T","二、双人合作跳绳","title",null,null]]},"goal_fields":["text","basis","from","show"],"goals":{"2aad57da-eea6-3655-6ffa-35f20e381704":{"take":"做到规范、标准地做出抱拳礼动作，并能说出参与体育活动的部分价值与安全注意。","later":"观看比赛或更复杂套路及术语熟练运用","items":[["学生能在教师示范后，按步骤规范、标准地做出抱拳礼动作并与同伴完成两次互做演练。",["PE-S2-SS-05.1"],"做出所学中华传统体育类运动项目的基本动作","分解动作规范，抱拳礼动作完整、姿势端正、连续两次无明显错误。"],["学生能结合课文与教师提问，说出参与体育活动的两项主要益处并举一例本课体现的价值（如强身或传承文化）。",["PE-S2-HE-01.1"],"说出参与体育活动的益处","口头列举两项益处，并能用一句话说明抱拳礼体现的价值。"],["学生能与同伴交流民族英雄的事迹，提出一条在学练中互相帮助或自我防护的具体行为建议。",["PE-S2-SS-05.2"],"与同伴交流交往","与同伴简短对话并说出一条互助或安全防护的具体做法。"]]},"a3a47d83-1850-8d29-cea6-0a8038c45816":{"take":"掌握中暑的紧急处理要点，能在模拟情境中冷静实施基本降温与转移措施。","later":"","items":[["学生能在教师讲解与情景演练中，按步骤说出并演示中暑时将人移至阴凉处、解松衣物、降温三项紧急处理动作。",["PE-S2-HE-01.1"],"发生运动伤病时能进行简单处理","能在演练中把“中暑者”移至阴凉、解松衣物并用湿毛巾降温。"],["学生能在情景模拟下辨认两种常见中暑表现并说出何时需要及时报告成人或寻求进一步帮助。",["PE-S2-HE-01.1"],"发生运动伤病时能进行简单处理","能说出如高热、意识不清时应立即找老师并停止运动。"]]},"620b359c-cd73-b70d-9ebe-6d98816f9a92":{"take":"在体能比赛情境中按规则参与，表现出公平竞争与团队协作的基本行为。","later":"","items":[["学生能在教师组织的体能游戏中遵守规则并按要求完成比赛项目，表现出基本的公平竞争行为。",["PE-S2-PF-01.3"],"按照规则和要求参与体能游戏和比赛","按规则完成赛程，不争抢裁判判罚，能说出一条遵守规则的理由。"]]},"0b256011-f1bd-15c5-6b09-f7929022084f":{"take":"能辨别含糖饮料并能在情境中选择更健康的饮品并说明理由。","later":"","items":[["学生能在饮料图片或实物比较中指出含糖饮料，并说出少喝含糖饮料的两条具体健康理由。",["PE-S2-HE-01.2"],"合理饮用饮料","指出至少1种含糖饮料并口述2条少喝理由"],["学生能在日常情境（如买饮料）选择更健康的替代饮品，并说明自己的选择。",["PE-S2-HE-01.2"],"合理饮用饮料","在情景选择中选出白开水或无糖饮品并说明理由"]]},"df048ecb-e82f-baa3-cb39-973bfda945f5":{"take":"能说出并在安排中坚持每天至少2小时户外活动，掌握两项用眼卫生的具体做法。","later":"近视矫正的方法与专业处理留到后续学段。","items":[["学生能在小组活动中说明每天白天坚持至少2小时户外活动的好处，并能写出两条支持理由。",["PE-S2-HE-01.2","PE-S2-HE-01.1"],"注意用眼卫生","口述2条户外活动有助预防近视的理由并写出实施时间"],["学生能示范并说出两种具体的用眼卫生行为（如正确读写姿势、定时休息），并能在课堂中做一次读写姿势自检。",["PE-S2-HE-01.2","PE-S2-HE-01.1"],"运用科学的方法预防近视","现场示范正确读写姿势并说出每40分钟休息眼睛的做法"]]},"6e43e241-ae20-38fd-52c5-3e7832f4f213":{"take":"能说出促进良好睡眠的主要习惯，并能在作息表中制定简单就寝计划以减轻疲劳。","later":"","items":[["学生能列出两项促进良好睡眠的生活习惯，并在家庭作息表上填写明晚的就寝时间与准备步骤。",["PE-S2-HE-01.3"],"促进人体生长发育的主要因素并在生活中加以运用","在作息表上写出就寝时间并列出两项准备习惯"],["学生能在讨论情境中说出良好睡眠如何帮助消除疲劳，并用一句话描述自己将采取的一项改善措施。",["PE-S2-HE-01.3"],"表现出调控情绪的意识","口述睡眠助疲劳恢复的一点，并说出1项改进措施"]]},"5d6cb480-5ab6-efee-4065-edaebdc09bcd":{"take":"引导学生能识别常见消极情绪并能选择并演示缓解愤怒等情绪的具体方法（场景化练习）。","later":"","items":[["学生能在教师提供的生活或体育情境中，指出两种常见消极情绪并说出各自可选的调节方法（至少两种），能当场选择合适方法进行尝试。",["PE-S2-HE-01.3"],"表现出调控情绪的意识","在情境卡中辨认出愤怒/焦虑并说出并示范两种调节方法"]]},"c05a875d-4576-9adb-0159-c632a2a3bf46":{"take":"通过小组体能合作活动训练学生用积极交流与同伴协调节奏、共同完成任务的能力（能说能做）。","later":"","items":[["学生能在小组体能练习中，用简短语言提出节奏或分工建议并与同伴协商调整练习节奏，完成规定动作或接力任务。",["PE-S2-PF-01.2"],"与同伴合作完成体能学练","在小组练习中提出改速或分工建议并被组内采纳后完成任务"],["学生能说出并在活动中示范两条积极与他人交流与合作的具体原则（如轮流发言、互相鼓励），并在练习中运用。",["PE-S2-PF-01.2"],"根据身体感受调整练习节奏","口述两条合作原则并在小组中用鼓励或轮流完成练习"]]}}}
