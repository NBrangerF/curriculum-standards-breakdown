{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": "npm run build",
    "installCommand": "npm install",
    "outputDirectory": "dist",
    "functions": {
        "api/cards/[...path].ts": {
            "maxDuration": 15,
            "includeFiles": "{public/data/{manifest.json,starmap.json,indexes/code_to_subject.json,by_subject/**,v2/manifest.json,v2/by_subject/**},node_modules/@fontsource/{noto-serif-sc/{400.css,files/*-{400,900}-normal.woff},ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff}}"
        },
        "api/v1/[...path].ts": {
            "maxDuration": 60,
            "supportsCancellation": true,
            "includeFiles": "{public/data/**,data/textbooks/library-state/**,data/textbooks/catalog/**,docs/api/**,node_modules/swagger-ui-dist/swagger-ui.css,node_modules/swagger-ui-dist/swagger-ui-bundle.js}"
        }
    },
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
            ]
        },
        {
            "source": "/((?!api/).*)",
            "headers": [
                { "key": "X-Content-Type-Options", "value": "nosniff" },
                { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
                { "key": "Content-Security-Policy", "value": "object-src 'none'; base-uri 'self'; frame-ancestors 'self'" },
                { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
                { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
            ]
        }
    ],
    "redirects": [
        {
            "source": "/schedule",
            "has": [{ "type": "query", "key": "edition", "value": "(?<edition>ed_[0-9a-f]+)" }],
            "destination": "/textbooks/:edition",
            "permanent": true
        },
        { "source": "/schedule", "destination": "/textbooks", "permanent": true },
        { "source": "/textbook-alignment", "destination": "/textbooks", "permanent": true },
        {
            "source": "/review",
            "has": [{ "type": "query", "key": "subject", "value": "(?<subject>chinese|math|english|morality_law|history|geography|science|physics|chemistry|biology|it|pe|arts|labor)" }],
            "destination": "/knowledge-graph/:subject",
            "permanent": true
        },
        { "source": "/review", "destination": "/knowledge-graph", "permanent": true }
    ],
    "rewrites": [
        {
            "source": "/api/v1/:path*",
            "destination": "/api/v1/[...path]"
        },
        {
            "source": "/mcp",
            "destination": "/api/v1/[...path]"
        },
        {
            "source": "/cards/:path*",
            "destination": "/api/cards/[...path]"
        },
        {
            "source": "/api",
            "destination": "/api-page.html"
        },
        {
            "source": "/((?!api|data|assets|.*\\..*).*)",
            "destination": "/app-shell.html"
        }
    ]
}
