{
  "book": {"subject": "数学", "grade": 6, "term": "上", "edition": "人教版"},
  "misconceptions": [
    {"id": "frac-mult-whole-den", "name": "整数和分母相乘", "why": "以为分数乘整数要乘分母。", "move": "想意义：{2/3} × 6 是 6 个 {2/3}，分母表示平均分的份数，不变。"},
    {"id": "frac-mult-both", "name": "分子、分母都乘了整数", "why": "把分数的基本性质和分数乘法混了。", "move": "问：{12/18} 和 {2/3} 相等吗？那么乘了 6 有没有变大？"},
    {"id": "frac-of-remaining", "name": "求成了剩下的部分", "why": "没看清问的是用去的还是剩下的。", "move": "画线段图，把“用去”和“剩下”分别标出来。"},
    {"id": "frac-div-as-mult", "name": "除以一个分数当成乘这个分数", "why": "没有把除数变成倒数。", "move": "估一估：{3/4} 里面有几个 {1/2}？结果应该比 {3/4} 大还是小？"},
    {"id": "frac-div-flip-wrong", "name": "把被除数颠倒了", "why": "记住了“颠倒”，没记住颠倒的是除数。", "move": "口诀：除以一个数，等于乘这个数的倒数；被除数不动。"},
    {"id": "frac-of-vs-whole", "name": "已知部分求整体却用了乘法", "why": "看到“几分之几”就乘。", "move": "先找单位“1”：单位“1”不知道，就设为 x 列方程或用除法。"},
    {"id": "ratio-vs-value", "name": "把比值当成化简后的比", "why": "化简比的结果应是一个比，求比值的结果是一个数。", "move": "并排写：化简比 3 : 0.6 = 5 : 1；求比值 3 : 0.6 = 5。"},
    {"id": "ratio-order", "name": "比的前项和后项颠倒", "why": "没按题目里两个量的顺序写。", "move": "先说“谁比谁”，再写比。"},
    {"id": "ratio-part-swap", "name": "按比分配时求成了另一部分", "why": "没对上哪一份是一班的。", "move": "画线段图：一班 4 份、二班 5 份，标清楚再算。"},
    {"id": "ratio-total-parts", "name": "只求出了总份数", "why": "求出 4 + 5 = 9 份就停了。", "move": "问：9 是份数还是本数？每份是多少本？"},
    {"id": "circle-area-perimeter", "name": "求面积用了周长公式", "why": "把 2πr 和 πr² 混了。", "move": "看单位：面积是平方厘米，要两个长度相乘。"},
    {"id": "circle-diameter-as-radius", "name": "把直径当成半径代入", "why": "题目给的是直径，或把半径乘了 2 再代入。", "move": "先写出 r = ？再代入公式。"},
    {"id": "scale-area-linear", "name": "以为面积和长度按同样倍数变化", "why": "没想到面积是两个长度相乘。", "move": "画边长 1 和边长 2 的正方形，数一数里面有几个小正方形。"},
    {"id": "percent-raw-count", "name": "把人数直接当成百分数", "why": "没有用部分除以总数。", "move": "问：出勤率是谁占谁的百分之几？总人数是多少？"},
    {"id": "percent-wrong-part", "name": "求成了另一部分的百分率", "why": "用缺勤人数去除了。", "move": "先说清求的是出勤还是缺勤，再找对应的人数。"},
    {"id": "percent-different-wholes", "name": "忽略了单位“1”不同", "why": "百分数大，不一定人数多，要看总数。", "move": "举例：甲校 100 人的 30%，乙校 400 人的 25%，各是多少人？"},
    {"id": "odd-sum-count", "name": "连续奇数的个数数错了", "why": "1 到 19 的奇数有 10 个，不是 9 个。", "move": "用 (19 + 1) ÷ 2 求个数，或一个一个列出来数。"},
    {"id": "odd-sum-last", "name": "用最后一个奇数的平方当和", "why": "记住了“和是平方数”，没想清是谁的平方。", "move": "用点阵拼正方形：每加一个奇数，边长多 1。边长等于奇数的个数。"}
  ],
