  "misconceptions": [
    {"id": "zero-divisor", "name": "以为任何数除以 0 得 0", "why": "把“0 除以一个数得 0”反过来用了。", "move": "用乘法想：5 ÷ 0 = □，就是 □ × 0 = 5，有这样的 □ 吗？"},
    {"id": "distribute-partial", "name": "分配律只乘了括号里的一个数", "why": "没想到括号里的两个数都要和外面的数相乘。", "move": "画一个长方形，长分成 8 和 4 两段，宽是 125，面积怎样算？"},
    {"id": "distribute-vs-associative", "name": "把分配律和结合律混了", "why": "看到 × 和括号，就把加号改成了乘号。", "move": "两种算式各算一遍得数，比一比相不相等。"},
    {"id": "decimal-longer-bigger", "name": "小数位数多就以为大", "why": "把小数部分当成整数来比。", "move": "把 0.3 写成 0.30，再和 0.25 比；或在百格图上涂一涂。"},
    {"id": "decimal-zero-property", "name": "把小数的性质用到了整数上", "why": "只记住“末尾添 0 大小不变”，没记住是小数的末尾。", "move": "比一比 5 和 50；再比 5.0 和 5.00。"},
    {"id": "decimal-unit-shift", "name": "换算时小数点移错了位数", "why": "没想清楚进率 1000 要移动几位。", "move": "先说进率是 10、100 还是 1000，再决定小数点移一位、两位还是三位。"},
    {"id": "decimal-zero-drop", "name": "换算时把中间的 0 丢了", "why": "3.05 看成 3.5 来换算。", "move": "把 3.05 千克拆开读：3 千克和 0.05 千克（50 克）。"},
    {"id": "triangle-inequality-any", "name": "以为任意三根小棒都能围成三角形", "why": "没想到短的两根可能够不着。", "move": "用 3 cm、4 cm、8 cm 的纸条围一围，看能不能接上。"},
    {"id": "triangle-inequality-equal", "name": "两边之和等于第三边也以为能围成", "why": "没注意“大于”，两边合起来正好平躺在第三边上。", "move": "用 3 cm、4 cm、7 cm 的纸条摆一摆，看能不能围出一个角。"},
    {"id": "angle-sum-size", "name": "以为三角形越小，内角和越小", "why": "把三角形的大小和角的度数联系在一起。", "move": "把一个三角形剪成两个，量一量两个小三角形的三个角，各加起来。"},
    {"id": "decimal-align-right", "name": "小数加减时末位对齐", "why": "把整数加减“末位对齐”套到小数上。", "move": "竖式里先对齐小数点，相同数位才能相加减。"},
    {"id": "parallelogram-symmetric", "name": "以为平行四边形是轴对称图形", "why": "觉得图形“很规整”就对称，没试着对折。", "move": "剪一个一般的平行四边形，沿各种直线对折，看能不能完全重合。"},
    {"id": "mean-is-everyone", "name": "以为平均数就是每个人的数", "why": "把“平均每人”当成了“每人都是”。", "move": "用积木演示移多补少：平均数是匀一匀以后的数，原来各人可以不同。"},
    {"id": "mean-forget-divide", "name": "求平均数只求了总数", "why": "忘了还要除以份数。", "move": "说一说平均数的意思：总数平均分成几份，每份是多少？"},
    {"id": "chicken-rabbit-swap", "name": "把求出的鸡当成了兔", "why": "用“假设全是鸡”求出的是兔的只数，却弄反了。", "move": "画图：先每只都画 2 条腿，多出的腿该添给谁？"},
    {"id": "chicken-rabbit-no-divide", "name": "腿数差没有除以 2", "why": "每只兔比鸡多 2 条腿，求只数要除以 2。", "move": "问：把 1 只鸡换成 1 只兔，腿多了几条？"}
