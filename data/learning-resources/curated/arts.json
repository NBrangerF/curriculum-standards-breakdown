      "summary_zh": "伦勃朗《夜巡》、维米尔《倒牛奶的女仆》等荷兰黄金时代名作都可下载超高清图，多数标注为公有领域或 CC0。少数作品仍有版权，会单独标出 CC BY 4.0。",
      "how_to_use_zh": "下载前确认作品页的版权标注为公有领域或 CC0，再用于课件。",
      "standards": [
        {
          "code": "AR-H4G7-CU-005",
          "rationale_zh": "提供欧洲经典绘画的高清图，帮助了解外国美术作品的产生背景和特征。"
        },
        {
          "code": "AR-H4G7-CU-002",
          "rationale_zh": "超高清图可放大到笔触，适合运用欣赏方法评述世界美术作品。"
        }
      ],
      "checked_at": "2026-10-28"
    },
    {
      "id": "pepper-and-carrot",
      "title_zh": "《胡椒与胡萝卜》开源网络漫画",
      "title_original": "Pepper&Carrot",
      "provider": "David Revoy（法国插画师）",
      "url": "https://www.peppercarrot.com/zh/",
      "license": "CC-BY-4.0",
      "license_url": "https://www.peppercarrot.com/en/license/index.html",
      "open_level": "open",
      "formats": [
        "book"
      ],
      "languages": [
        "zh",
        "en"
      ],
      "china_access": "direct",
      "subjects": [
        "arts",
        "english"
      ],
      "stages": [
        "G5-6",
        "G7-9"
      ],
      "summary_zh": "讲述小女巫和她的猫的数字绘画漫画，每集只有几页，有简体中文和英文等几十种语言版本。作者公开了源文件和创作过程，允许改编和再创作。",
      "how_to_use_zh": "分析一集的分镜和色彩，再让学生用同样角色续画一页。",
      "standards": [
        {
          "code": "AR-D3-AA-017",
          "rationale_zh": "每集漫画分镜清晰，可作为编写微电影脚本和分镜草图的参考范例。"
        },
        {
          "code": "AR-H4G7-CP-012",
          "rationale_zh": "漫画用连续画面讲故事，可借此练习“把创意故事进行视听化编排”的分镜思维。"
        },
        {
          "code": "EN-H4G7-LA-004",
          "rationale_zh": "英文版图文结合、对白简短，是课标所说的图文多模态语篇。"
        }
      ],
      "checked_at": "2026-10-28"
    },
