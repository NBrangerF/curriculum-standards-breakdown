      "summary_zh": "两千多首由志愿者重新排版的古典乐谱，可下载 PDF 和 MIDI。每首曲谱单独标注许可，均为公有领域、CC BY 或 CC BY-SA，可以自由打印和改编。",
      "how_to_use_zh": "按乐器搜索竖笛、钢琴等简单曲目，打印乐谱并播放 MIDI 作示范。",
      "standards": [
        {
          "code": "AR-D2-AE-013",
          "rationale_zh": "可以下载简单器乐曲的五线谱和 MIDI，用于“读懂并运用简易乐谱进行演奏练习”。"
        },
        {
          "code": "AR-H4G7-AE-007",
          "rationale_zh": "收有大量重奏谱，适合挑选多声部作品进行合作演奏。"
        }
      ],
      "checked_at": "2026-10-28"
    },
    {
      "id": "chrome-music-lab",
      "title_zh": "Chrome 音乐实验室",
      "title_original": "Chrome Music Lab",
      "provider": "Google 创意实验室",
      "url": "https://musiclab.chromeexperiments.com/",
      "license": "Apache-2.0",
      "license_url": "https://github.com/googlecreativelab/chrome-music-lab/blob/master/LICENSE",
      "open_level": "open",
      "formats": [
        "interactive",
        "tool"
      ],
      "languages": [
        "en"
      ],
      "china_access": "direct",
      "subjects": [
        "arts"
      ],
      "stages": [
        "G1-2",
        "G7-9"
      ],
      "summary_zh": "十几个在浏览器里玩的音乐小实验：在方格上点出旋律的“歌曲制作器”（Song Maker）、做节奏的“节奏”、试听和弦的“和弦”、观察声波的“频谱”等。界面以图标为主，打开即用，不需要识谱基础。源代码以 Apache 2.0 许可开源。",
      "how_to_use_zh": "用“歌曲制作器”让学生在方格上排出一段旋律，再唱一唱、改一改。",
      "standards": [
        {
          "code": "AR-D1-AE-004",
          "rationale_zh": "在方格上用色块表示音高和节奏，对应“用线条、色块或图形等方式表示所听到的音乐”。"
        },
        {
          "code": "AR-D1-AE-012",
          "rationale_zh": "低年级学生可以直接拖点编创简单节奏或旋律，为表演配乐。"
        },
        {
          "code": "AR-H4G7-CP-017",
          "rationale_zh": "在“歌曲制作器”里即兴编创旋律短句，再用“和弦”实验试配和弦，对应编创节奏、旋律短句和和弦。"
        }
      ],
