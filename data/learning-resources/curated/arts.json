    {
      "id": "met-open-access",
      "title_zh": "大都会艺术博物馆开放获取藏品",
      "title_original": "The Met Open Access",
      "provider": "美国大都会艺术博物馆（The Met）",
      "url": "https://www.metmuseum.org/art/collection/search?showOnly=openAccess",
      "license": "CC0-1.0",
      "license_url": "https://www.metmuseum.org/hubs/open-access",
      "open_level": "open",
      "formats": [
        "dataset"
      ],
      "languages": [
        "en"
      ],
      "china_access": "unstable",
      "subjects": [
        "arts",
        "labor"
      ],
      "stages": [
        "G3-4",
        "G5-6",
        "G7-9"
      ],
      "summary_zh": "大都会博物馆约 49 万件公有领域藏品的高清图片以 CC0 开放，包括大量中国书画、青铜器、瓷器和织绣。搜索时勾选“Open Access”，下载的图片可直接用于课件、印刷和改编。",
      "how_to_use_zh": "按“Chinese”或具体朝代检索，挑选作品做高清局部放大欣赏。",
      "standards": [
        {
          "code": "AR-D2-AA-002",
          "rationale_zh": "高清大图便于学生观察细节，围绕中外美术作品的内容与特点进行描述和评述。"
        },
        {
          "code": "AR-H4G7-CU-005",
          "rationale_zh": "馆藏横跨中外各时期，可以按时间线编排作品，帮助了解中外美术的产生背景和特征。"
        },
        {
          "code": "LA-H4G7-PL-007",
          "rationale_zh": "瓷器、漆器、刺绣等工艺品的高清图，可作为传统工艺制作前观察纹样与结构的范例。"
        }
      ],
      "checked_at": "2026-10-28"
    },
    {
      "id": "smithsonian-open-access",
      "title_zh": "史密森学会开放获取资源",
      "title_original": "Smithsonian Open Access",
      "provider": "美国史密森学会（Smithsonian Institution）",
      "url": "https://www.si.edu/openaccess",
      "license": "CC0-1.0",
      "license_url": "https://www.si.edu/openaccess/faq",
      "open_level": "open",
      "formats": [
        "dataset"
      ],
      "languages": [
        "en"
      ],
      "china_access": "blocked",
      "subjects": [
        "arts",
        "science"
      ],
      "stages": [
        "G1-2",
        "G7-9"
      ],
      "summary_zh": "史密森学会旗下博物馆、动物园和研究机构开放的数百万张图片和三维模型，标有 CC0 的均可自由使用。内容既有国立亚洲艺术博物馆的中国艺术品，也有动植物标本和化石照片。",
      "how_to_use_zh": "在搜索结果中筛选 CC0，下载高清图做观察记录或艺术欣赏材料。",
      "standards": [
        {
          "code": "AR-H4G7-CU-002",
          "rationale_zh": "可以选取世界各地的美术作品高清图，用造型元素和形式原理进行评述。"
        },
        {
          "code": "SC-D1-PR-019",
          "rationale_zh": "动植物标本的高清照片可放大观察，帮助低年级学生如实记录动植物的结构特征。"
        }
      ],
      "checked_at": "2026-10-28"
    },
    {
      "id": "cleveland-open-access",
      "title_zh": "克利夫兰艺术博物馆开放获取",
      "title_original": "Cleveland Museum of Art Open Access",
      "provider": "美国克利夫兰艺术博物馆",
      "url": "https://www.clevelandart.org/art/collection/search?open_access=1",
      "license": "CC0-1.0",
      "license_url": "https://www.clevelandart.org/open-access",
      "open_level": "open",
      "formats": [
        "dataset"
      ],
      "languages": [
        "en"
      ],
      "china_access": "direct",
      "subjects": [
        "arts"
      ],
      "stages": [
        "G3-4",
        "G7-9"
      ],
      "summary_zh": "该馆把公有领域藏品的高清图片和资料以 CC0 开放，中国书画和陶瓷收藏尤其丰富。每件作品页面有尺寸、年代和简短介绍，可以无需申请直接下载。",
      "how_to_use_zh": "选两件同题材的中外作品并排展示，引导学生比较线条、色彩和构图。",
      "standards": [
        {
          "code": "AR-D2-AE-001",
          "rationale_zh": "高清图便于学生用线条、色彩、构图等美术语言描述作品，并解释它们如何影响表达。"
        },
        {
          "code": "AR-H4G7-CU-005",
          "rationale_zh": "丰富的中国古代书画藏品，可帮助学生认识中国经典美术作品。"
        }
      ],
      "checked_at": "2026-10-28"
    },
